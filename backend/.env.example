# =============================================================================
# HEABRON COOPSCORE — BACKEND ENV
# =============================================================================
# Copy this file to .env and fill in real values for local development.
# In production (Vercel), set these as Environment Variables in the dashboard.

# ----- Server -----
NODE_ENV=development
PORT=4000

# ----- Public URLs -----
# The URL the frontend app(s) use to call this API (used in email links)
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# ----- JWT -----
# 64+ character random string. Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_64_character_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ----- Supabase -----
# From your Supabase project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ.....
# Service role key – NEVER expose to frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ.....

# ----- Resend (email) -----
# Sign up at https://resend.com and create an API key.
# We use the onboarding/test sender for now.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Heabron CoopScore <onboarding@resend.dev>
RESEND_REPLY_TO=info@heabron.com

# ----- NIN Verification (NINAuth) -----
# See README — NINAuth is the official NIMC service. Apply for an
# organization account at https://app.ninauth.nimc.gov.ng/developers
NIN_PROVIDER=ninauth
NINAUTH_BASE_URL=https://api.ninauth.nimc.gov.ng
NINAUTH_CLIENT_ID=
NINAUTH_CLIENT_SECRET=
# Fallback / dev mode — when no provider is configured, the service
# returns "verified" for any 11-digit NIN. Do not enable in production.
NIN_DEV_MODE=true

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ----- Branding (used in emails) -----
BRAND_NAME=Heabron CoopScore
BRAND_LOGO_URL=https://i.imgur.com/RIpNqJw.png
BRAND_PRIMARY_COLOR=#2C6B47
BRAND_ACCENT_COLOR=#E0A82E
BRAND_SUPPORT_EMAIL=info@heabron.com
BRAND_WEBSITE=https://www.heabron.com
